# Copy to backend/.env and adjust. All variables are optional.
# Every setting can also be supplied as an environment variable (same name).

# --- runtime ---------------------------------------------------------------
LQ_ENVIRONMENT=development
LQ_LOG_LEVEL=INFO
LQ_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- database --------------------------------------------------------------
# Defaults to data/lumenquant.db (SQLite, WAL). PostgreSQL works via SQLAlchemy:
# LQ_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lumenquant
# LQ_DATABASE_URL=sqlite:///D:/LumenQuant/data/lumenquant.db

# --- market simulator ------------------------------------------------------
LQ_SEED_MARKET=true
LQ_MARKET_SEED_BARS=11520
LQ_MARKET_TICK_SECONDS=5
LQ_RUNTIME_ENABLED=true
LQ_ENGINE_INTERVAL_SECONDS=2

# --- execution costs -------------------------------------------------------
LQ_FEE_BPS=10
LQ_SLIPPAGE_BPS=3

# --- risk ------------------------------------------------------------------
LQ_RISK_MAX_ORDER_NOTIONAL=1000000
LQ_RISK_MAX_POSITION_NOTIONAL=5000000
LQ_RISK_MIN_ORDER_NOTIONAL=10
LQ_RISK_MAX_ORDERS_PER_MINUTE=120
LQ_RISK_MAX_DAILY_LOSS_PCT=0.05
LQ_RISK_MAX_DRAWDOWN_PCT=0.25

# --- security --------------------------------------------------------------
# Enable before exposing the API beyond localhost.
LQ_AUTH_ENABLED=false
LQ_AUTH_TOKEN=
LQ_RATE_LIMIT_PER_MINUTE=600

# --- live trading (disabled by default) ------------------------------------
# Turning this on requires BOTH the switch and the credentials below.
# Live orders additionally require the header  X-Live-Confirm: true.
LQ_LIVE_TRADING_ENABLED=false
# Strategy instances place orders without any HTTP request, so they need their
# own switch. Re-checked on every scheduler tick: turning it off stops entries on
# instances that already exist. Protective exits (stop-loss) keep running.
LQ_LIVE_AUTO_TRADING_ENABLED=false
LQ_BINANCE_API_KEY=
LQ_BINANCE_API_SECRET=
LQ_BINANCE_BASE_URL=https://api.binance.com

# --- market data sources ---------------------------------------------------
# synthetic (default, offline, reproducible) | binance (public tickers + klines,
# no API key, no account access). `binance` stops the synthetic engine entirely:
# two writers on one price series makes prices jump between two universes.
LQ_CRYPTO_DATA_SOURCE=synthetic
LQ_CRYPTO_DATA_BASE_URL=https://data-api.binance.vision
LQ_CRYPTO_REALTIME_ENABLED=true
LQ_CRYPTO_QUOTE_POLL_SECONDS=5
# Real-history depth per symbol on import. Binance caps one call at 1000 bars and
# the source pages past it, so these totals are reachable.
LQ_CRYPTO_SYNC_INTRADAY_LIMIT=8000
LQ_CRYPTO_SYNC_DAILY_LIMIT=2000

# --- A-share mode ----------------------------------------------------------
LQ_CN_SYMBOLS_ENABLED=true
LQ_CN_SEED_DAYS=600
# Enforce the 09:30-11:30 / 13:00-15:00 gate for paper orders too.
LQ_CN_SESSION_ENFORCED=false
# Live A-share orders are gated on the real Beijing session; only disable for rehearsal.
LQ_CN_LIVE_SESSION_GATE=true
# Extend the trading calendar (weekday closures, typhoons): JSON array of YYYY-MM-DD.
LQ_CN_EXTRA_HOLIDAYS=[]
LQ_CN_COMMISSION_BPS=2.5
LQ_CN_MIN_COMMISSION=5
LQ_CN_STAMP_DUTY_BPS=5
LQ_CN_TRANSFER_FEE_BPS=0.1

# --- A-share data source ---------------------------------------------------
# synthetic (default) | tencent (public quotes + klines). Real data is opt-in
# because it needs network access.
LQ_CN_DATA_SOURCE=synthetic
# Import daily + 15m history once at startup (failure only logs; local data stays).
LQ_CN_SYNC_ON_START=false
# Practical ceilings of the free upstream (measured): 15m -> 800 bars
# (~50 trading days), daily -> 2000 bars (~8 years). A-share minute history is
# not available further back, so long intraday research must aggregate from 1d
# or import a CSV.
LQ_CN_SYNC_DAILY_LIMIT=2000
LQ_CN_SYNC_INTRADAY_LIMIT=800
# Realtime quote polling; only active with LQ_CN_DATA_SOURCE=tencent.
LQ_CN_REALTIME_ENABLED=true
# In-session interval. Outside sessions it stretches to max(60s, 4x), and it
# backs off exponentially while the upstream is failing.
LQ_CN_QUOTE_POLL_SECONDS=15

# --- Tonghuashun (同花顺) order gateway -------------------------------------
# Authorized HTTP order gateway. This platform never automates the THS client.
LQ_THS_GATEWAY_URL=
LQ_THS_GATEWAY_TOKEN=
# In-process deterministic gateway for demos/tests of the live path.
LQ_THS_MOCK_ENABLED=false
LQ_LIVE_RECONCILE_SECONDS=3

# --- AI assistant (optional) -----------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Without these the assistant
# runs in deterministic local mode.
LQ_LLM_BASE_URL=
LQ_LLM_API_KEY=
LQ_LLM_MODEL=
